            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ArUco Marker 2 -->
    <model name='aruco_marker_2'>
      <static>true</static>
      <pose>4 0 0.5 0 0 -1.5708</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.01 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
