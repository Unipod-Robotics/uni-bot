      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ArUco Marker 3 -->
    <model name='aruco_marker_3'>
      <static>true</static>
      <pose>3 -2 0.5 0 0 0.7854</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.01 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0 0 0 1</specular>
