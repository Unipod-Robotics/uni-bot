<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ubot_ros2_control" params="prefix use_gazebo">
    <ros2_control name="UbotSystem" type="system">
      <hardware>
        <xacro:if value="${use_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
          <joint name="${prefix}rear_left_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
          <joint name="${prefix}rear_right_wheel_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
        </xacro:if>
        <xacro:unless value="${use_gazebo}">
          <plugin>ubot_control/UbotHardware</plugin>
          <param name="left_wheel_name">front_left_wheel_joint</param>
          <param name="right_wheel_name">front_right_wheel_joint</param>
          <param name="enc_counts_per_rev_left">3956</param>
          <param name="enc_counts_per_rev_right">3956</param>
          <param name="wheel_separation">0.264204</param>
          <param name="wheel_radius">0.033</param>
          <param name="loop_rate">30</param>
        </xacro:unless>
      </hardware>

      <!-- Front wheels: velocity command + position/velocity state -->
      <joint name="${prefix}front_left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}front_right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Rear Wheels -->
      <joint name="${prefix}rear_left_wheel_joint">
        <!-- In Gazebo, we need command interfaces for the 4WD diff_drive_controller -->
        <xacro:if value="${use_gazebo}">
          <command_interface name="velocity"/>
        </xacro:if>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}rear_right_wheel_joint">
        <xacro:if value="${use_gazebo}">
          <command_interface name="velocity"/>
        </xacro:if>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>
  </xacro:macro>
</robot>
